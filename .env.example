# --- Base de données ---
# Connexion PostgreSQL. En local : voir docker-compose.yml ou Postgres natif.
# En production (Vercel) : copier l'URL Neon (https://neon.tech) ici.
DATABASE_URL=postgresql://andrea:andrea@127.0.0.1:5432/andrea_planet

# --- Sécurité ---
# Clé secrète utilisée pour signer les JWT de session admin.
# Générer une chaîne aléatoire de 32+ caractères (openssl rand -hex 32).
PAYLOAD_SECRET=remplacez-moi-par-une-chaine-aleatoire-tres-longue

# --- URLs publiques ---
# Pas de slash final. En prod : https://votre-domaine.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Jobs / prévisualisation ---
CRON_SECRET=remplacez-moi-aussi
PREVIEW_SECRET=remplacez-moi-encore
